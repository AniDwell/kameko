{
  "expo": {
    "name": "kameko",
    "slug": "kameko",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/Kameko_logo.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/kameko_header.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "androidStatusBar": {
      "hidden": true,
      "translucent": true
    },
    "androidNavigationBar": {
      "visible": "sticky-immersive"
    },
    "android": {
      "backgroundColor": "#000000",
      "adaptiveIcon": {
        "foregroundImage": "./assets/Kameko_logo.png",
        "backgroundColor": "#000000"
      },
      "package": "com.kameko.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK"
      ]
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "icon": "./assets/Kameko_logo.png",
          "color": "#E50914"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "multiDexEnabled": true,
            "packagingOptions": {
              "pickFirst": [
                "**/libc++_shared.so",
                "**/libffmpegkit.so"
              ]
            }
          }
        }
      ]
    ]
  }
}
